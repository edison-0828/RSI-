{
  "name": "rsi-bottom-hunter-ui",
  "version": "1.0.0",
  "private": true,
  "description": "SuperTrend 翻转交易 - 基于 OKX SuperTrend 翻转反手的多空交易面板",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "test": "node --test server/test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "puppeteer-core": "^24.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  },
  "engines": {
    "node": ">=18"
  }
}
