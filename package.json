{
  "name": "rsi-bottom-hunter-ui",
  "version": "1.0.0",
  "private": true,
  "description": "RSI抄底宝 - 基于 OKX RSI 超卖信号的抄底策略监控面板",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run server\" \"npm run client\"",
